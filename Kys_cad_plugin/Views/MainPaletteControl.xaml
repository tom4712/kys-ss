<UserControl x:Class="Kys_cad_plugin.Views.MainPaletteControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             Background="{DynamicResource ApplicationBackgroundBrush}" 
             Foreground="{DynamicResource TextFillColorPrimaryBrush}"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TextBox x:Name="SearchBox" Grid.Row="0" Margin="10" 
                    PlaceholderText="기능 검색..." TextChanged="SearchBox_TextChanged"
                    Icon="{ui:SymbolIcon Symbol=Search24}" ClearButtonEnabled="True"
                    Visibility="Collapsed"/>

        <TreeView x:Name="CommandTree" Grid.Row="1" BorderThickness="0" Background="Transparent"
                  SelectedItemChanged="CommandTree_SelectedItemChanged" Padding="10,0"
                  Visibility="Collapsed">
        </TreeView>

        <StackPanel x:Name="LockArea" Grid.Row="0" Grid.RowSpan="2" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Visible">
            <iconPacks:PackIconFontAwesome Kind="LockSolid" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Width="48" Height="48" HorizontalAlignment="Center" Margin="0,0,0,15" Opacity="0.7"/>
            <TextBlock Text="라이선스 인증이 되어있지 않습니다." FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
            <TextBlock Text="하단의 [License 확인] 버튼을 눌러 인증해주세요." FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" Margin="0,5,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="10">
            <ui:ToggleSwitch x:Name="ToggleMaster" 
                             Content="플러그인 명령어 활성화" 
                             FontSize="11" 
                             FontWeight="Normal"
                             Margin="0,0,0,8"
                             HorizontalAlignment="Left"/>

            <ui:Button HorizontalAlignment="Stretch" 
                       Appearance="Secondary"
                       Click="LicenseButton_Click">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <iconPacks:PackIconFontAwesome Kind="CertificateSolid" 
                                                 Foreground="#FFD700" 
                                                 Width="16" 
                                                 Height="16" 
                                                 Margin="0,0,8,0"
                                                 VerticalAlignment="Center"/>
                    <TextBlock x:Name="LicenseBtnText"
                               Text="License 확인" 
                               FontWeight="SemiBold" 
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                </StackPanel>
            </ui:Button>
        </StackPanel>

        <ContentPresenter x:Name="DialogHost" Grid.Row="0" Grid.RowSpan="3" />
    </Grid>
</UserControl>