<ui:FluentWindow x:Class="Kys_cad_plugin.Views.EoToAreaShpUI"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                 Title="EO -> 영역 SHP 변환" 
                 Width="1200" Height="850"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 Background="{DynamicResource ApplicationBackgroundBrush}"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                 FontFamily="Segoe UI, Malgun Gothic"
                 SnapsToDevicePixels="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="EO -> 영역 SHP 변환 (Footprint)" Padding="15,5"/>

        <Grid Grid.Row="1" Margin="25,10,25,25">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="15"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="15"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ui:Card Grid.Row="0" Padding="20">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <iconPacks:PackIconFontAwesome Kind="DrawPolygonSolid" Width="18" Height="18" Margin="0,0,8,0" Foreground="#27AE60" VerticalAlignment="Center"/>
                            <TextBlock Text="카메라 센서 제원" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>

                        <ComboBox x:Name="CboSensorType" HorizontalAlignment="Stretch" SelectionChanged="CboSensorType_SelectionChanged" Margin="0,0,0,10">
                            <ComboBoxItem Content="DMC1"/>
                            <ComboBoxItem Content="DMC2"/>
                            <ComboBoxItem Content="DMC3"/>
                            <ComboBoxItem Content="Osprey4.1"/>
                            <ComboBoxItem Content="CountryMapper"/>
                            <ComboBoxItem Content="CountryMapper(90)"/>
                            <ComboBoxItem Content="사용자입력"/>
                        </ComboBox>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="가로픽셀" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <ui:TextBox x:Name="TxtWidth" TextAlignment="Right"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="2">
                                <TextBlock Text="세로픽셀" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <ui:TextBox x:Name="TxtHeight" TextAlignment="Right"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="0">
                                <TextBlock Text="초점거리(m)" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <ui:TextBox x:Name="TxtFocal" TextAlignment="Right"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="2">
                                <TextBlock Text="픽셀크기(μm)" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <ui:TextBox x:Name="TxtPixelSize" TextAlignment="Right"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ui:Card>

                <ui:Card Grid.Row="2" Padding="20">
                    <StackPanel>
                        <TextBlock Text="분석 진행률" FontWeight="Bold" FontSize="12" Margin="0,0,0,8"/>
                        <ProgressBar x:Name="PrgStatus" Height="10" Foreground="#27AE60"/>
                        <TextBlock x:Name="TxtStatus" Text="대기 중" FontSize="11" Margin="0,5,0,0" HorizontalAlignment="Right"/>
                    </StackPanel>
                </ui:Card>

                <StackPanel Grid.Row="4">
                    <ui:Button Appearance="Secondary" HorizontalAlignment="Stretch" Height="45" Click="BtnLoadEo_Click" Margin="0,0,0,10">
                        <TextBlock Text="EO 파일 로드 및 범위 계산" FontWeight="SemiBold"/>
                    </ui:Button>
                    <ui:Button Appearance="Primary" Height="60" HorizontalAlignment="Stretch" Click="BtnExportShp_Click" Background="#27AE60" BorderBrush="#27AE60">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Save24" Margin="0,0,8,0"/>
                            <TextBlock Text="영역 SHP 파일 저장" FontWeight="Bold" FontSize="16"/>
                        </StackPanel>
                    </ui:Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="15"/>
                    <RowDefinition Height="1.2*"/>
                </Grid.RowDefinitions>

                <ui:Card Grid.Row="0" Padding="0" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="{DynamicResource ControlFillColorDefaultBrush}" Padding="15,10" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource ControlElevationBorderBrush}">
                            <TextBlock Text="원본 EO 데이터 리스트" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </Border>

                        <DataGrid Grid.Row="1" x:Name="EoDataGrid" 
                                  VerticalAlignment="Stretch"
                                  AutoGenerateColumns="False" 
                                  IsReadOnly="True" 
                                  HeadersVisibility="Column" 
                                  Background="Transparent" 
                                  BorderThickness="0"
                                  RowHeight="30">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="1.5*"/>
                                <DataGridTextColumn Header="X" Binding="{Binding X, StringFormat={}{0:F3}}" Width="*"/>
                                <DataGridTextColumn Header="Y" Binding="{Binding Y, StringFormat={}{0:F3}}" Width="*"/>
                                <DataGridTextColumn Header="Z" Binding="{Binding Z, StringFormat={}{0:F3}}" Width="*"/>
                                <DataGridTextColumn Header="KAP" Binding="{Binding Kappa}" Width="80"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </ui:Card>

                <ui:Card Grid.Row="2" Padding="0" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="{DynamicResource ControlFillColorDefaultBrush}" Padding="15,10" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource ControlElevationBorderBrush}">
                            <TextBlock Text="계산된 영상 범위 (Footprint)" FontWeight="Bold" Foreground="#27AE60"/>
                        </Border>

                        <DataGrid Grid.Row="1" x:Name="AreaDataGrid" 
                                  VerticalAlignment="Stretch"
                                  AutoGenerateColumns="False" 
                                  IsReadOnly="True" 
                                  HeadersVisibility="Column" 
                                  Background="Transparent" 
                                  BorderThickness="0" 
                                  FontSize="11"
                                  RowHeight="30">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="100" FontWeight="Bold"/>
                                <DataGridTextColumn Header="좌상단(TL)" Binding="{Binding TL}" Width="*"/>
                                <DataGridTextColumn Header="우상단(TR)" Binding="{Binding TR}" Width="*"/>
                                <DataGridTextColumn Header="좌하단(BL)" Binding="{Binding BL}" Width="*"/>
                                <DataGridTextColumn Header="우하단(BR)" Binding="{Binding BR}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </ui:Card>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>