<ui:FluentWindow x:Class="Kys_cad_plugin.Views.RetakeAnalysisUI"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                 Title="재촬영 구간 분석 및 시각화" 
                 Width="900" Height="780" MinWidth="850" MinHeight="650"
                 WindowStartupLocation="CenterScreen"
                 WindowState="Normal" 
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 Background="{DynamicResource ApplicationBackgroundBrush}"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                 FontFamily="Segoe UI, Malgun Gothic"
                 SnapsToDevicePixels="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="재촬영 구간 분석 시스템" Padding="15,5"/>

        <Grid Grid.Row="1" Margin="30,15,30,30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="15"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="15"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ui:Card Grid.Row="0" Padding="25,18">
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <iconPacks:PackIconFontAwesome Kind="RotateSolid" Width="18" Height="18" Margin="0,0,10,0" Foreground="#009688" VerticalAlignment="Center"/>
                        <TextBlock Text="도면 텍스트(코스번호_사진번호) 기반 구간 추출" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="도면 내 'TT' 도면층에 있는 텍스트를 분석하여 코스별로 분류하고, 누락된 번호를 찾아 앞뒤 버퍼(3장)가 포함된 노란색 영역 박스를 생성합니다." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </ui:Card>

            <ui:Card Grid.Row="2" Padding="25" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="25"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <ui:Button Grid.Column="0" x:Name="BtnLoadTexts" Content="도면에서 TT 텍스트 가져오기" Click="BtnLoadTexts_Click" Appearance="Secondary" Height="36" Icon="ArrowDownload24"/>

                        <TextBlock Grid.Column="2" Text="사각형 도면층:" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <ui:TextBox Grid.Column="4" x:Name="TxtLayerName" Text="KYSQL_RETAKE_BOX" Height="36" ClearButtonEnabled="False"/>

                        <TextBlock Grid.Column="6" Text="사각형 높이(m):" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <ui:TextBox Grid.Column="8" x:Name="TxtBoxHeight" Text="100" Height="36" TextAlignment="Center" ClearButtonEnabled="False"/>
                    </Grid>

                    <Grid Grid.Row="2" VerticalAlignment="Stretch">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal">
                            <TextBlock Text="코스별 대상 범위 설정" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text=" 💡 '끝 사진 번호' 열은 엑셀에서 복사(Ctrl+C) 후 여기에 연속 붙여넣기(Ctrl+V)가 가능합니다." FontSize="11" Foreground="#27AE60" Margin="10,0,0,0" VerticalAlignment="Bottom"/>
                        </StackPanel>

                        <DataGrid Grid.Row="2" x:Name="CourseDataGrid" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" 
                                  Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1"
                                  SelectionMode="Extended" SelectionUnit="Cell" KeyDown="CourseDataGrid_KeyDown" RowHeight="34" 
                                  VerticalAlignment="Stretch" MinHeight="350">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="코스 번호 (예: C01, 127)" Binding="{Binding CourseName}" IsReadOnly="True" Width="200"/>
                                <DataGridTextColumn Header="도면 내 매수" Binding="{Binding ExtractedCount}" IsReadOnly="True" Width="110"/>
                                <DataGridTextColumn Header="시작 사진 번호" Binding="{Binding StartNumber, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                                <DataGridTextColumn Header="끝 사진 번호 (Excel 붙여넣기 가능)" Binding="{Binding EndNumber, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>
            </ui:Card>

            <ui:Button Grid.Row="4" x:Name="BtnRunAnalysis" Appearance="Primary" Height="62" HorizontalAlignment="Stretch" Click="BtnRunAnalysis_Click" Background="#009688" BorderBrush="#009688">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconFontAwesome Kind="CheckSolid" Width="18" Height="18" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <TextBlock Text="재촬영 구간 분석 및 노란 박스 도면 표기" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
                </StackPanel>
            </ui:Button>
        </Grid>
    </Grid>
</ui:FluentWindow>