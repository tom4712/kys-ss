<ui:FluentWindow x:Class="Kys_cad_plugin.Views.EoIdChangeUI"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                 Title="EO 번호 일괄변경" 
                 Width="700" Height="600"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 Background="{DynamicResource ApplicationBackgroundBrush}"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                 FontFamily="Segoe UI, Malgun Gothic"
                 SnapsToDevicePixels="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="EO 번호 일괄변경" Padding="15,5"/>

        <Grid Grid.Row="1" Margin="25,10,25,25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="15"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="15"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ui:Card Grid.Row="0" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <iconPacks:PackIconFontAwesome Kind="LocationDotSolid" Width="18" Height="18" Margin="0,0,8,0" Foreground="#E67E22" VerticalAlignment="Center"/>
                        <TextBlock Text="원본 EO 데이터 불러오기 및 코스 분석" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ui:TextBox Grid.Column="0" x:Name="TxtFilePath" IsReadOnly="True" PlaceholderText="EO 파일(txt)을 선택하세요..."/>
                        <ui:Button Grid.Column="2" x:Name="BtnSelectFile" Content="파일 찾기" Click="BtnSelectFile_Click" Icon="FolderOpen24"/>

                        <StackPanel Grid.Column="4" Orientation="Horizontal">
                            <TextBlock Text="시간차(초):" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <ui:TextBox x:Name="TxtTimeGap" Text="15" Width="50" TextAlignment="Center"/>
                            <ui:Button x:Name="BtnAnalyze" Content="분석" Click="BtnAnalyze_Click" Margin="5,0,0,0" Appearance="Secondary"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </ui:Card>

            <ui:Card Grid.Row="2" Padding="15" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="코스별 이름 및 시작번호 지정" FontWeight="Bold" FontSize="12" Margin="0,0,0,8" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                    <DataGrid Grid.Row="1" x:Name="CourseDataGrid" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" 
                              Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="코스" Binding="{Binding CourseIndex}" IsReadOnly="True" Width="60"/>
                            <DataGridTextColumn Header="매수" Binding="{Binding PhotoCount}" IsReadOnly="True" Width="60"/>
                            <DataGridTextColumn Header="기존 시작 ID" Binding="{Binding OldStartId}" IsReadOnly="True" Width="100"/>
                            <DataGridTextColumn Header="새 코스명 (예: C01_)" Binding="{Binding NewCourseName}" Width="150"/>
                            <DataGridTextColumn Header="시작 번호 (예: 1)" Binding="{Binding NewStartNumber}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </ui:Card>

            <Grid Grid.Row="4">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock Text="저장 포맷 :" FontWeight="Bold" Margin="0,0,10,0"/>
                    <RadioButton x:Name="RbTxt" Content="TXT" IsChecked="True" Margin="0,0,15,0"/>
                    <RadioButton x:Name="RbExcel" Content="CSV (Excel)"/>
                </StackPanel>

                <ui:Button x:Name="BtnExport" Appearance="Primary" Height="45" Width="200" HorizontalAlignment="Right" Click="BtnExport_Click" Background="#E67E22" BorderBrush="#E67E22">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconFontAwesome Kind="FloppyDiskSolid" Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="새로운 EO 저장" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                    </StackPanel>
                </ui:Button>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>