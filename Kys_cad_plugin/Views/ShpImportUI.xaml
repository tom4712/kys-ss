<ui:FluentWindow x:Class="Kys_cad_plugin.Views.ShpImportUI"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                 Title="SHP 도면 가져오기 (정밀 투영 지원)" 
                 Width="680" Height="620"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 Background="{DynamicResource ApplicationBackgroundBrush}"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                 FontFamily="Segoe UI, Malgun Gothic"
                 SnapsToDevicePixels="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="SHP 파일 정밀 불러오기" Padding="15,5"/>

        <Grid Grid.Row="1" Margin="25,10,25,25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="15"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="15"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ui:Card Grid.Row="0" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="15"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="15"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <iconPacks:PackIconFontAwesome Kind="MapSolid" Width="18" Height="18" Margin="0,0,8,0" Foreground="#27AE60" VerticalAlignment="Center"/>
                            <TextBlock Text="Shapefile(.shp) 캐드 도면화 및 좌표계 투영" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="SHP 파일의 원본 좌표계를 현재 작업 중인 DWG 도면의 좌표계로 실시간 변환하여 100% 정확한 위치에 작도합니다." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ui:TextBox Grid.Column="0" x:Name="TxtFilePath" IsReadOnly="True" PlaceholderText="불러올 SHP 파일을 선택하세요... (.prj 자동 감지)" Height="36"/>
                        <ui:Button Grid.Column="2" x:Name="BtnSelectFile" Content="파일 찾기" Click="BtnSelectFile_Click" Icon="FolderOpen24" Height="36"/>
                    </Grid>

                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="현재 도면(DWG) 좌표계:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        <ComboBox Grid.Column="2" x:Name="CmbDwgCoord" Height="34" VerticalContentAlignment="Center" SelectedIndex="2"/>

                        <TextBlock Grid.Column="4" Text="원본 SHP 좌표계:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#D83B01"/>
                        <ComboBox Grid.Column="6" x:Name="CmbShpCoord" Height="34" VerticalContentAlignment="Center" SelectedIndex="2"/>
                    </Grid>
                </Grid>
            </ui:Card>

            <ui:Card Grid.Row="2" Padding="15" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="15"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="도면층(Layer) 대상:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <ui:TextBox Grid.Column="2" x:Name="TxtLayerName" Text="SHP_IMPORT_DATA" Height="34" ClearButtonEnabled="False"/>
                    </Grid>

                    <ListBox Grid.Row="2" x:Name="LogListBox" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1" ScrollViewer.VerticalScrollBarVisibility="Auto" Padding="5">
                        <TextBlock Text="▶ 파일을 선택하면 PRJ 유무를 감지하여 원본 좌표계가 자동 세팅됩니다." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="2"/>
                    </ListBox>
                </Grid>
            </ui:Card>

            <ui:Button Grid.Row="4" x:Name="BtnImportShp" Appearance="Primary" Height="55" HorizontalAlignment="Stretch" Click="BtnImportShp_Click" Background="#27AE60" BorderBrush="#27AE60">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconFontAwesome Kind="FileImportSolid" Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="투영 변환 후 도면에 SHP 데이터 그리기" FontWeight="Bold" FontSize="15" VerticalAlignment="Center"/>
                </StackPanel>
            </ui:Button>
        </Grid>
    </Grid>
</ui:FluentWindow>