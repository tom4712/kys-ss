<ui:FluentWindow x:Class="Kys_cad_plugin.Views.EoToTfwUI"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                 Title="외부표정요소(EO) -> TFW 변환" 
                 Width="1100" Height="850"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 Background="{DynamicResource ApplicationBackgroundBrush}"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                 FontFamily="Segoe UI, Malgun Gothic"
                 SnapsToDevicePixels="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="외부표정요소(EO) -> TFW 변환" Padding="15,5"/>

        <Grid Grid.Row="1" Margin="25,10,25,25">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="15"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="15"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ui:Card Grid.Row="0" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="15"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="15"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                <iconPacks:PackIconFontAwesome Kind="CameraRetroSolid" Width="18" Height="18" Margin="0,0,8,0" Foreground="#27AE60" VerticalAlignment="Center"/>
                                <TextBlock Text="카메라 및 계산 옵션" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>

                        <ComboBox Grid.Row="2" x:Name="CboSensorType" HorizontalAlignment="Stretch" SelectionChanged="CboSensorType_SelectionChanged">
                            <ComboBoxItem Content="DMC1"/>
                            <ComboBoxItem Content="DMC2"/>
                            <ComboBoxItem Content="DMC3"/>
                            <ComboBoxItem Content="Osprey4.1"/>
                            <ComboBoxItem Content="CountryMapper"/>
                            <ComboBoxItem Content="CountryMapper(90)"/>
                            <ComboBoxItem Content="사용자입력"/>
                        </ComboBox>

                        <Grid Grid.Row="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="가로 픽셀" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <ui:TextBox x:Name="TxtWidth" TextAlignment="Right"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="2">
                                <TextBlock Text="세로 픽셀" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <ui:TextBox x:Name="TxtHeight" TextAlignment="Right"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="0">
                                <TextBlock Text="초점거리(m)" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <ui:TextBox x:Name="TxtFocal" TextAlignment="Right"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="2">
                                <TextBlock Text="픽셀크기(μm)" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <ui:TextBox x:Name="TxtPixelSize" TextAlignment="Right"/>
                            </StackPanel>
                        </Grid>

                        <ui:Card Grid.Row="6" Padding="10" Background="{DynamicResource ControlFillColorSecondaryBrush}">
                            <CheckBox x:Name="ChkIgnoreKappa" Content="Kappa(KAP) 회전 무시 (0도 고정)" IsChecked="False" FontWeight="SemiBold" Foreground="#27AE60"/>
                        </ui:Card>
                    </Grid>
                </ui:Card>

                <ui:Card Grid.Row="2" Padding="20">
                    <StackPanel>
                        <TextBlock Text="데이터 처리 진행률" FontWeight="Bold" FontSize="12" Margin="0,0,0,10" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <ProgressBar x:Name="PrgStatus" Minimum="0" Maximum="100" Value="0" Height="10" Foreground="#27AE60"/>
                        <Grid Margin="0,8,0,0">
                            <TextBlock x:Name="TxtProgress" Text="0%" FontSize="12" FontWeight="Bold" Foreground="#27AE60"/>
                            <TextBlock x:Name="TxtCountStatus" Text="0 / 0" HorizontalAlignment="Right" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </Grid>
                    </StackPanel>
                </ui:Card>

                <StackPanel Grid.Row="4">
                    <ui:Button Appearance="Secondary" HorizontalAlignment="Stretch" Height="45" Click="BtnLoadEo_Click" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="DocumentSearch24" Margin="0,0,8,0"/>
                            <TextBlock Text="EO 파일 불러오기 및 계산" FontWeight="SemiBold"/>
                        </StackPanel>
                    </ui:Button>

                    <ui:Button x:Name="BtnSaveTfw" Appearance="Primary" Height="60" HorizontalAlignment="Stretch" Click="BtnSaveTfw_Click" Background="#27AE60" BorderBrush="#27AE60">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconFontAwesome Kind="FileExportSolid" Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="폴더 지정 및 TFW 저장" FontWeight="Bold" FontSize="15"/>
                        </StackPanel>
                    </ui:Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="15"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <ui:Card Grid.Row="0" Padding="0" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="{DynamicResource ControlFillColorDefaultBrush}" Padding="15,10" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource ControlElevationBorderBrush}">
                            <TextBlock Text="원본 EO 데이터 리스트" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </Border>
                        <DataGrid Grid.Row="1" x:Name="EoDataGrid" VerticalAlignment="Stretch" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" Background="Transparent" BorderThickness="0" RowHeight="30">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="1.2*" FontWeight="SemiBold"/>
                                <DataGridTextColumn Header="X" Binding="{Binding X, StringFormat={}{0:F3}}" Width="*"/>
                                <DataGridTextColumn Header="Y" Binding="{Binding Y, StringFormat={}{0:F3}}" Width="*"/>
                                <DataGridTextColumn Header="Z" Binding="{Binding Z, StringFormat={}{0:F3}}" Width="*"/>
                                <DataGridTextColumn Header="Kappa" Binding="{Binding Kappa}" Width="80" Foreground="#27AE60"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </ui:Card>

                <ui:Card Grid.Row="2" Padding="0" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="{DynamicResource ControlFillColorDefaultBrush}" Padding="15,10" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource ControlElevationBorderBrush}">
                            <TextBlock Text="계산된 TFW 변환 데이터 (MBR)" FontWeight="Bold" Foreground="#27AE60"/>
                        </Border>
                        <DataGrid Grid.Row="1" x:Name="CalcDataGrid" VerticalAlignment="Stretch" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" Background="Transparent" BorderThickness="0" RowHeight="30">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="1.2*" FontWeight="SemiBold"/>
                                <DataGridTextColumn Header="GSD(m)" Binding="{Binding Gsd, StringFormat={}{0:F4}}" Width="80"/>
                                <DataGridTextColumn Header="좌상단 X" Binding="{Binding TopLeftX, StringFormat={}{0:F3}}" Width="*"/>
                                <DataGridTextColumn Header="좌상단 Y" Binding="{Binding TopLeftY, StringFormat={}{0:F3}}" Width="*"/>
                                <DataGridTextColumn Header="적용 Kappa" Binding="{Binding AppliedKappa}" Width="90" Foreground="#D83B01"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </ui:Card>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>