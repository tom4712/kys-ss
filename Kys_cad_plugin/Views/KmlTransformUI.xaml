<ui:FluentWindow x:Class="Kys_cad_plugin.Views.KmlTransformUI"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                 Title="KML / KMZ 구글어스 상호 변환 시스템" 
                 Width="750" Height="620"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 Background="{DynamicResource ApplicationBackgroundBrush}"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                 FontFamily="Segoe UI, Malgun Gothic"
                 SnapsToDevicePixels="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="KML / KMZ 변환 관리자" Padding="15,5"/>

        <TabControl Grid.Row="1" Margin="20,10,20,20" Background="Transparent" BorderThickness="0">

            <TabItem Header="구글어스 내보내기 (Export)">
                <Grid Margin="0,15,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="15"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="15"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ui:Card Grid.Row="0" Padding="20">
                        <StackPanel>
                            <TextBlock Text="1. 좌표계 선택 및 도면 인식" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,10"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="15"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="160"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="✔ 현재 도면(Model Space)의 모든 도면층 자동 인식" VerticalAlignment="Center" FontWeight="Bold" Foreground="#27AE60" FontSize="14"/>

                                <TextBlock Grid.Column="2" Text="도면 좌표계 (WKT):" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <ComboBox Grid.Column="4" x:Name="CmbCoordSystem" Height="36" VerticalContentAlignment="Center" SelectedIndex="2"/>
                            </Grid>
                        </StackPanel>
                    </ui:Card>

                    <ui:Card Grid.Row="2" Padding="20" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="내보내기 변환 로그 및 가이드" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <ListBox Grid.Row="2" x:Name="ExportLogBox" MinHeight="200" Background="{DynamicResource ControlFillColorDefaultBrush}">
                                <TextBlock Text="▶ 선택한 좌표계 파라미터를 기반으로 캐드 좌표를 정밀 WGS84 위경도로 투영(Projection)합니다." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </ListBox>
                        </Grid>
                    </ui:Card>

                    <ui:Button Grid.Row="4" x:Name="BtnExportKml" Appearance="Primary" Height="55" HorizontalAlignment="Stretch" Click="BtnExportKml_Click" Background="#27AE60" BorderBrush="#27AE60">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconFontAwesome Kind="FileExportSolid" Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="전체 도면 구글어스(KML/KMZ) 파일로 저장" FontWeight="Bold" FontSize="15" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ui:Button>
                </Grid>
            </TabItem>

            <TabItem Header="구글어스 가져오기 (Import)">
                <Grid Margin="0,15,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="15"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="15"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ui:Card Grid.Row="0" Padding="20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="2. 원본 구글어스 파일 선택 (.kml / .kmz)" FontSize="13" FontWeight="SemiBold"/>
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="15"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ui:TextBox Grid.Column="0" x:Name="TxtImportPath" IsReadOnly="True" PlaceholderText="구글어스에서 저장한 kml/kmz 파일을 선택하세요..." Height="36"/>
                                <ui:Button Grid.Column="2" x:Name="BtnSelectImportFile" Content="파일 찾기" Click="BtnSelectImportFile_Click" Icon="FolderOpen24" Height="36"/>
                            </Grid>
                        </Grid>
                    </ui:Card>

                    <ui:Card Grid.Row="2" Padding="20" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="생성할 캐드 도면층:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <ui:TextBox Grid.Column="2" x:Name="TxtImportLayer" Text="KYSQL_GOOGLE_IMPORT" Height="34" ClearButtonEnabled="False"/>
                            </Grid>
                            <ListBox Grid.Row="2" x:Name="ImportLogBox" Margin="0,10,0,0" MinHeight="180" Background="{DynamicResource ControlFillColorDefaultBrush}"/>
                        </Grid>
                    </ui:Card>

                    <ui:Button Grid.Row="4" x:Name="BtnImportKml" Appearance="Secondary" Height="55" HorizontalAlignment="Stretch" Click="BtnImportKml_Click">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconFontAwesome Kind="FileImportSolid" Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="구글어스 데이터를 캐드 도면에 그리기" FontWeight="Bold" FontSize="15" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ui:Button>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</ui:FluentWindow>