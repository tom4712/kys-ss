<ui:FluentWindow x:Class="Kys_cad_plugin.Views.BlockFilterUI"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                 Title="블럭 필터 기반 객체 선택" 
                 Width="600" Height="680"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 Background="{DynamicResource ApplicationBackgroundBrush}"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                 FontFamily="Segoe UI, Malgun Gothic"
                 SnapsToDevicePixels="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="블럭 필터 기반 객체 선택" Padding="15,5"/>

        <Grid Grid.Row="1" Margin="25,10,25,25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="15"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="15"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="15"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ui:Card Grid.Row="0" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="15"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <iconPacks:PackIconFontAwesome Kind="DatabaseSolid" Width="18" Height="18" Margin="0,0,8,0" Foreground="#009688" VerticalAlignment="Center"/>
                            <TextBlock Text="블럭 DB 데이터 불러오기" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="블럭(BL)과 코스 번호가 매핑된 텍스트(TXT/CSV) 파일을 선택하세요." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ui:TextBox Grid.Column="0" x:Name="TxtDbFilePath" IsReadOnly="True" PlaceholderText="선택된 파일 없음" Icon="{ui:SymbolIcon Symbol=DocumentText24}" Height="40" VerticalContentAlignment="Center"/>

                        <ui:Button Grid.Column="2" Appearance="Secondary" Height="40" Padding="20,0" Click="BtnLoadDb_Click">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="FolderOpen24" Margin="0,0,8,0"/>
                                <TextBlock Text="파일 찾기" FontWeight="SemiBold"/>
                            </StackPanel>
                        </ui:Button>
                    </Grid>
                </Grid>
            </ui:Card>

            <ui:Card Grid.Row="2" Padding="20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <iconPacks:PackIconFontAwesome Kind="FilterSolid" Width="18" Height="18" Margin="0,0,8,0" Foreground="#009688" VerticalAlignment="Center"/>
                            <TextBlock Text="검색할 블럭(BL) 필터 선택" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="선택한 블럭에 해당하는 코스 데이터를 도면에서 찾습니다." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>

                    <ComboBox Grid.Column="2" x:Name="CboBlockList" Width="150" Height="40" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold"/>
                </Grid>
            </ui:Card>

            <ui:Card Grid.Row="4" Padding="15" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="작업 로그" FontWeight="Bold" FontSize="12" Margin="0,0,0,8" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <ListBox Grid.Row="1" x:Name="LogListBox" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1" ScrollViewer.VerticalScrollBarVisibility="Auto" Padding="5">
                        <TextBlock Text="▶ DB 파일을 먼저 불러와주세요." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="2"/>
                    </ListBox>
                </Grid>
            </ui:Card>

            <ui:Button Grid.Row="6" x:Name="BtnFindAndMove" Appearance="Primary" Height="55" HorizontalAlignment="Stretch" Click="BtnFindAndMove_Click" Background="#009688" BorderBrush="#009688">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconFontAwesome Kind="MagnifyingGlassLocationSolid" Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="도면에서 객체 선택 및 화면 이동" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
                </StackPanel>
            </ui:Button>
        </Grid>
    </Grid>
</ui:FluentWindow>