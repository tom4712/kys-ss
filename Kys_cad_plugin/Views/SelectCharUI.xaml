<ui:FluentWindow x:Class="Kys_cad_plugin.Views.SelectCharUI"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                 Title="특정 문자 포함 객체 선택" 
                 Width="550" Height="550"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 Background="{DynamicResource ApplicationBackgroundBrush}"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                 FontFamily="Segoe UI, Malgun Gothic"
                 SnapsToDevicePixels="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="특정 문자 포함 객체 선택" Padding="15,5"/>

        <Grid Grid.Row="1" Margin="25,10,25,25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="15"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="15"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ui:Card Grid.Row="0" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <iconPacks:PackIconFontAwesome Kind="ArrowPointerSolid" Width="18" Height="18" Margin="0,0,8,0" Foreground="#8764B8" VerticalAlignment="Center"/>
                            <TextBlock Text="검색할 문자 입력" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="입력한 문자가 포함된 모든 텍스트(Text, MText)를 찾아 선택합니다." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ui:TextBox Grid.Column="0" x:Name="TxtSearchKeyword" PlaceholderText="예) A, 용인, 용수" Icon="{ui:SymbolIcon Symbol=Search24}" Height="40" VerticalContentAlignment="Center" FontSize="14" KeyDown="TxtSearchKeyword_KeyDown"/>

                        <CheckBox Grid.Column="2" x:Name="ChkExactMatch" Content="정확히 일치" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                    </Grid>
                </Grid>
            </ui:Card>

            <ui:Card Grid.Row="2" Padding="15" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="검색 결과 로그" FontWeight="Bold" FontSize="12" Margin="0,0,0,8" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <ListBox Grid.Row="1" x:Name="LogListBox" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1" ScrollViewer.VerticalScrollBarVisibility="Auto" Padding="5">
                        <TextBlock Text="▶ 찾고자 하는 문자를 입력하고 검색을 실행하세요." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="2"/>
                    </ListBox>
                </Grid>
            </ui:Card>

            <ui:Button Grid.Row="4" x:Name="BtnSearchAndSelect" Appearance="info" Height="55" HorizontalAlignment="Stretch" Click="BtnSearchAndSelect_Click">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconFontAwesome Kind="MagnifyingGlassLocationSolid" Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="도면에서 문자 찾기 및 선택" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
                </StackPanel>
            </ui:Button>
        </Grid>
    </Grid>
</ui:FluentWindow>