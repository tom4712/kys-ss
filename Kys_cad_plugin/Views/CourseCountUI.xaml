<ui:FluentWindow x:Class="Kys_cad_plugin.Views.CourseCountUI"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                 Title="코스별 매수 확인" 
                 Width="950" Height="700"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 Background="{DynamicResource ApplicationBackgroundBrush}"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                 FontFamily="Segoe UI, Malgun Gothic"
                 SnapsToDevicePixels="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="코스별 매수 확인" Padding="15,5"/>

        <Grid Grid.Row="1" Margin="25,10,25,25">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="15"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ui:Card Grid.Row="0" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="15"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                <iconPacks:PackIconFontAwesome Kind="RouteSolid" Width="18" Height="18" Margin="0,0,8,0" Foreground="#009688" VerticalAlignment="Center"/>
                                <TextBlock Text="물량 분석 설정" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="텍스트 데이터를 스캔하여 코스별 매수를 산출합니다." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2">
                            <TextBlock Text="작업 대상 도면" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <ComboBox x:Name="CboTargetMode" HorizontalAlignment="Stretch" SelectedIndex="0" SelectionChanged="CboTargetMode_SelectionChanged">
                                <ComboBoxItem Content="현재 활성 도면만 (Current)"/>
                                <ComboBoxItem Content="열려있는 모든 도면 (All Open)"/>
                            </ComboBox>
                        </StackPanel>

                        <CheckBox Grid.Row="4" x:Name="ChkOnlyTTLayer" Content="이름에 'TT'가 포함된 도면층만 대상" IsChecked="False" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    </Grid>
                </ui:Card>

                <ui:Card Grid.Row="2" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="15"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="15"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="작업 진행 상태" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                        <ProgressBar Grid.Row="2" x:Name="PrgAnalyze" Minimum="0" Maximum="100" Value="0" Height="10" Foreground="#009688"/>

                        <Grid Grid.Row="4">
                            <TextBlock x:Name="TxtProgressPercent" Text="0%" HorizontalAlignment="Left" FontWeight="Bold" Foreground="#009688"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="필터 대상: " FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtTotalFound" Text="0" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text=" 매" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="2,0,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </ui:Card>

                <ui:Button Grid.Row="4" x:Name="BtnAnalyze" Appearance="Primary" Height="60" HorizontalAlignment="Stretch" Click="BtnAnalyze_Click" Background="#009688" BorderBrush="#009688">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Play24" Margin="0,0,8,0"/>
                        <TextBlock Text="물량 분석 시작" FontWeight="Bold" FontSize="16"/>
                    </StackPanel>
                </ui:Button>
            </Grid>

            <ui:Card Grid.Column="2" Padding="0" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" VerticalContentAlignment="Top">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="0,0,0,1" Padding="15,12">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Table24" Margin="0,0,8,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Text="코스별 분석 결과" FontWeight="Bold" FontSize="13"/>
                            </StackPanel>
                            <ui:Button HorizontalAlignment="Right" Appearance="Secondary" Padding="15,5" Click="BtnCopyToExcel_Click">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconFontAwesome Kind="FileArrowDownSolid" Width="14" Height="14" Margin="0,0,8,0" Foreground="AliceBlue"/>
                                    <TextBlock Text="내보내기" FontSize="12" FontWeight="SemiBold"/>
                                </StackPanel>
                            </ui:Button>
                        </Grid>
                    </Border>

                    <DataGrid Grid.Row="1" x:Name="ResultDataGrid" 
                              VerticalAlignment="Top"
                              AutoGenerateColumns="False" 
                              IsReadOnly="True" 
                              HeadersVisibility="Column" 
                              Background="Transparent"
                              BorderThickness="0"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{DynamicResource ControlElevationBorderBrush}"
                              ClipboardCopyMode="IncludeHeader"
                              SelectionMode="Single"
                              MouseDoubleClick="ResultDataGrid_MouseDoubleClick"
                              RowHeight="32">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <Setter Property="Padding" Value="10,8"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource ControlElevationBorderBrush}"/>
                            </Style>
                            <Style TargetType="DataGridCell">
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="10,0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridCell">
                                            <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="코스 (Course)" Binding="{Binding Course}" Width="*" FontWeight="SemiBold"/>
                            <DataGridTextColumn Header="본촬영" Binding="{Binding MainCount}" Width="80"/>
                            <DataGridTextColumn Header="재촬영" Binding="{Binding ReshootCount}" Width="80" Foreground="#E74C3C"/>
                            <DataGridTextColumn Header="전체매수" Binding="{Binding TotalCount}" Width="80" FontWeight="Bold"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </ui:Card>
        </Grid>
    </Grid>
</ui:FluentWindow>