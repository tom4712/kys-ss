<ui:FluentWindow x:Class="Kys_cad_plugin.Views.ExcelCollectUI"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                 Width="950" Height="680"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 Title="캐드 좌표 및 속성 수집기"
                 Background="{DynamicResource ApplicationBackgroundBrush}"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                 FontFamily="Segoe UI, Malgun Gothic" 
                 SnapsToDevicePixels="True">

    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <Style TargetType="GridViewColumnHeader">
                <Setter Property="Height" Value="38"/>
                <Setter Property="Padding" Value="15,0"/>
                <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="BorderBrush" Value="{DynamicResource ControlElevationBorderBrush}"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="GridViewColumnHeader">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style TargetType="ListViewItem">
                <Setter Property="Height" Value="35"/>
                <Setter Property="Margin" Value="0,2"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListViewItem">
                            <Border Background="{TemplateBinding Background}" CornerRadius="4" SnapsToDevicePixels="true">
                                <GridViewRowPresenter VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="캐드 좌표 및 속성 수집기" Padding="15,5"/>

        <Grid Grid.Row="1" Margin="20,10,20,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <ui:Card Grid.Row="0" Margin="0,0,0,15" Padding="20,15">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="TargetEdit24" FontSize="22" Margin="0,0,10,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                        <StackPanel>
                            <TextBlock Text="좌표 및 속성 수집" FontSize="16" FontWeight="Bold"/>
                            <TextBlock Text="캐드 도면에서 객체를 선택하여 데이터를 추출합니다." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <ui:Button x:Name="BtnCollect" Appearance="info" HorizontalAlignment="Right" Padding="25,10" Icon="{ui:SymbolIcon Symbol=Add24}" Click="BtnCollect_Click">
                        <TextBlock Text="도면에서 수집" FontWeight="SemiBold" FontSize="14"/>
                    </ui:Button>
                </Grid>
            </ui:Card>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="1.2*"/>
                </Grid.ColumnDefinitions>

                <ui:Card Grid.Column="0" Padding="0" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" VerticalContentAlignment="Top">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="0,0,0,1" Padding="15,10">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Table24" Margin="0,0,8,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Text="추출된 데이터 목록" FontWeight="Bold" FontSize="13"/>
                            </StackPanel>
                        </Border>

                        <ListView x:Name="CollectListView" Grid.Row="1" BorderThickness="0" Background="Transparent" SelectionMode="Extended" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Text" Width="120">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Text}" Margin="5,0,15,0" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="X" Width="Auto">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding X}" Margin="5,0,15,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Y" Width="Auto">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Y}" Margin="5,0,15,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Z" Width="Auto">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Z}" Margin="5,0,15,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="도면층 이름" Width="Auto">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding LayerName}" Margin="5,0,15,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Grid>
                </ui:Card>

                <ui:Card Grid.Column="2" Padding="20" VerticalAlignment="Stretch">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="15"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <ui:SymbolIcon Symbol="TextBulletList24" Margin="0,0,8,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                <TextBlock Text="엑셀 출력 항목 설정" FontWeight="Bold" FontSize="14"/>
                            </StackPanel>
                            <TextBlock Text="엑셀에 저장할 열(Column)을 선택하세요." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="* 기본값은 전체 선택입니다." FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,2,0,0"/>
                        </StackPanel>

                        <Border Grid.Row="2" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="15">
                            <StackPanel VerticalAlignment="Center">
                                <CheckBox x:Name="ChkText" Content="Text" IsChecked="True" Margin="0,5" FontWeight="SemiBold"/>
                                <CheckBox x:Name="ChkX" Content="X 좌표" IsChecked="True" Margin="0,5"/>
                                <CheckBox x:Name="ChkY" Content="Y 좌표" IsChecked="True" Margin="0,5"/>
                                <CheckBox x:Name="ChkZ" Content="Z 좌표" IsChecked="True" Margin="0,5"/>
                                <CheckBox x:Name="ChkLayer" Content="도면층 (Layer) 이름" IsChecked="True" Margin="0,5"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="4" Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="12,10">
                            <Grid>
                                <TextBlock Text="현재 수집된 항목" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock x:Name="TxtCollectedCount" Text="0" FontSize="16" FontWeight="Bold" Foreground="#E74C3C" VerticalAlignment="Center"/>
                                    <TextBlock Text=" 개" FontSize="12" VerticalAlignment="Bottom" Margin="2,0,0,2" Opacity="0.8"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <ui:Button Grid.Row="6" x:Name="BtnExportExcel" Appearance="Success" Height="60" HorizontalAlignment="Stretch" FontSize="16" FontWeight="Bold" Click="BtnExportExcel_Click">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconFontAwesome Kind="FileExcelSolid" Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="엑셀로 출력하기" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ui:Button>
                    </Grid>
                </ui:Card>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>