<ui:FluentWindow x:Class="Kys_cad_plugin.Views.PointToShpUI"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                 Title="주점(Point) -> SHP 변환" 
                 Width="600" Height="500"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 Background="{DynamicResource ApplicationBackgroundBrush}"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                 FontFamily="Segoe UI, Malgun Gothic"
                 SnapsToDevicePixels="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="주점(Point) -> SHP 변환" Padding="15,5"/>

        <Grid Grid.Row="1" Margin="25,10,25,25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="15"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="15"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ui:Card Grid.Row="0" Padding="20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <iconPacks:PackIconFontAwesome Kind="LocationDotSolid" Width="18" Height="18" Margin="0,0,8,0" Foreground="#27AE60" VerticalAlignment="Center"/>
                            <TextBlock Text="원(Circle) 객체를 SHP 포인트로 변환" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="선택한 원을 점(Point) 데이터로 내보내며, 동일 좌표의 텍스트를 속성값으로 매핑합니다." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </ui:Card>

            <ui:Card Grid.Row="2" Padding="15" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="작업 로그" FontWeight="Bold" FontSize="12" Margin="0,0,0,8" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <ListBox Grid.Row="1" x:Name="LogListBox" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1" ScrollViewer.VerticalScrollBarVisibility="Auto" Padding="5">
                        <TextBlock Text="▶ 아래 실행 버튼을 눌러 객체를 선택해 주세요." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="2"/>
                    </ListBox>
                </Grid>
            </ui:Card>

            <ui:Button Grid.Row="4" x:Name="BtnConvertShp" Appearance="Primary" Height="60" HorizontalAlignment="Stretch" Click="BtnConvertShp_Click" Background="#27AE60" BorderBrush="#27AE60">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconFontAwesome Kind="FileExportSolid" Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="객체 선택 및 SHP 파일 저장" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
                </StackPanel>
            </ui:Button>
        </Grid>
    </Grid>
</ui:FluentWindow>